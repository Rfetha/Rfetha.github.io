---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Layout from './Layout.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, placeholder } = Astro.props;
---

<Layout
	title={`${title} — ${SITE_TITLE}`}
	description={description}
	article={{ pubDate, updatedDate, headline: title }}
>
	<main>
		<article class="paper">
			<header>
				<h1>{title}</h1>
				<p class="byline">
					{SITE_TITLE} &nbsp;·&nbsp; <FormattedDate date={pubDate} />
					{
						updatedDate && (
							<>
								<br />
								<span class="revised">
									revised <FormattedDate date={updatedDate} />
								</span>
							</>
						)
					}
				</p>
				{
					placeholder && (
						<p class="placeholder">
							<b>Placeholder.</b> This entry exists to exercise the layout. It is not
							the author's writing and will be replaced.
						</p>
					)
				}
			</header>
			<slot />
		</article>
	</main>
</Layout>

<style>
	header {
		margin-bottom: 1.6rem;
	}
	h1 {
		text-align: center;
		margin-bottom: 0.25rem;
	}
	.byline {
		text-align: center;
		font-style: italic;
		font-size: 0.82em;
		color: var(--muted);
		margin: 0;
	}
	.revised {
		font-size: 0.92em;
		color: var(--faint);
	}
	.placeholder {
		margin: 1.2rem 0 0;
		padding: 0.6rem 0.85rem;
		border: 1px solid var(--sig);
		color: var(--sig);
		font-size: 0.82em;
		line-height: 1.5;
	}
	.placeholder b {
		font-family: var(--caps);
		font-weight: 400;
		letter-spacing: 0.05em;
	}
</style>
