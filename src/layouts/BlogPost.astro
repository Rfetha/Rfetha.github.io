---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Layout from './Layout.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: { depth: number; slug: string; text: string }[];
};

const { title, description, pubDate, updatedDate, placeholder, headings = [] } = Astro.props;

/** Why: only h2 carries a section in these posts; h3 is used inside a section
    for sub-parts and would make the rail longer than the prose it indexes. */
const sections = headings.filter((h) => h.depth === 2);

/* Why: the BibTeX entry is built here rather than typed into each post's
   markdown. The canonical URL is `site` in astro.config.mjs — which calls
   itself "one place to change when the site moves to its own domain" — and a
   hand-written copy in every post would silently rot the day that changes.
   Everything else already exists as frontmatter, so a post gets its citation
   by being a post. */
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const [given, ...rest] = SITE_TITLE.split(' ');
const surname = rest.at(-1) ?? given;
const year = pubDate.getUTCFullYear();

/* Why: a key like `ersoy2026why` reads as a typo, so the leading interrogative
   is skipped — the first word that actually names the subject wins. */
const SKIP = new Set(['why', 'how', 'what', 'the', 'a', 'an', 'and', 'of', 'on', 'in', 'to']);
const topic =
	Astro.url.pathname
		.replace(/^\/blog\/|\/$/g, '')
		.split('-')
		.find((w) => w.length > 2 && !SKIP.has(w)) ?? 'post';

/* Why: the title is double-braced. BibTeX lowercases a title it is allowed to
   restyle, and these titles carry proper nouns (Transformer, decoder-only)
   that must survive. */
const bibtex = `@misc{${surname.toLowerCase()}${year}${topic},
  author       = {${surname}, ${given}},
  title        = {{${title}}},
  year         = {${year}},
  howpublished = {\\url{${canonical}}}
}`;
---

<Layout
	title={`${title} — ${SITE_TITLE}`}
	description={description}
	article={{ pubDate, updatedDate, headline: title }}
>
	<main>
		{
			sections.length > 1 && (
				<nav class="toc" aria-label="Bölümler">
					<ol>
						{sections.map((s) => (
							<li>
								<a href={`#${s.slug}`}>{s.text}</a>
							</li>
						))}
					</ol>
				</nav>
			)
		}
		{/* Why: the page is genuinely bilingual — English chrome and title, Turkish
		    prose. `hyphens: auto` resolves against the nearest lang, and under the
		    document's `en` the English patterns find almost no break points in
		    Turkish, so justified text opened up into rivers. Marking the article
		    itself is more accurate than flipping the document language, and it
		    also switches screen-reader pronunciation at the right boundary. */}
		<article class="paper" lang="tr">
			<header>
				<h1>{title}</h1>
				<p class="byline">
					{SITE_TITLE} &nbsp;·&nbsp; <FormattedDate date={pubDate} />
					{
						updatedDate && (
							<>
								<br />
								<span class="revised">
									revised <FormattedDate date={updatedDate} />
								</span>
							</>
						)
					}
				</p>
				{
					placeholder && (
						<p class="placeholder">
							<b>Placeholder.</b> This entry exists to exercise the layout. It is not
							the author's writing and will be replaced.
						</p>
					)
				}
			</header>
			<slot />

			<footer class="cite">
				<p><b>Cite.</b> This entry, as BibTeX.</p>
				<pre><code>{bibtex}</code></pre>
			</footer>
		</article>

		{/* Why: figures are dense enough that the 952px column is not always
		    enough to read a label. Native <dialog> gives Esc, the focus trap and
		    the backdrop for free; without JS it simply never opens. */}
		<dialog class="lightbox" aria-label="Figür — tam ekran">
			<button class="lb-close" type="button" aria-label="Kapat">&#215;</button>
			{/* Why: the image element is built on first open rather than shipped
			    with an empty source, so it can never render as a broken box. */}
			<div class="lb-stage"></div>
		</dialog>
	</main>
</Layout>

<script>
	// Marks the rail entry for the section the reader is currently in. Purely
	// additive: without JS the rail is still a working list of anchors.
	const rail = document.querySelector('.toc');
	if (rail) {
		const heads = [...document.querySelectorAll('article.paper h2[id]')];
		const links = new Map(
			heads.map((h) => [h.id, rail.querySelector(`a[href="#${CSS.escape(h.id)}"]`)]),
		);

		const sync = () => {
			let current = heads[0];
			for (const h of heads) {
				if (h.getBoundingClientRect().top < 140) current = h;
			}
			for (const a of links.values()) a?.classList.remove('current');
			links.get(current?.id)?.classList.add('current');
		};

		addEventListener('scroll', sync, { passive: true });
		sync();
	}
</script>

<script>
	// Figures open full screen on click, then toggle between fit and zoomed.
	// Additive: without JS the figures stay exactly as they are in the column.
	const box = document.querySelector<HTMLDialogElement>('dialog.lightbox');
	const stage = box?.querySelector<HTMLElement>('.lb-stage');

	if (box && stage) {
		let shown: HTMLImageElement | null = null;

		const open = (from: HTMLImageElement) => {
			if (!shown) {
				shown = document.createElement('img');
				stage.append(shown);
			}
			shown.src = from.currentSrc || from.src;
			shown.alt = from.alt;
			box.classList.remove('zoomed');
			stage.scrollTo(0, 0);
			box.showModal();
		};

		for (const img of document.querySelectorAll<HTMLImageElement>('article.paper figure img')) {
			img.addEventListener('click', () => open(img));
		}

		// Why: anchor the zoom on the point clicked, otherwise zooming always
		// lands at the top-left corner and reads as a bug.
		stage.addEventListener('click', (e) => {
			if (e.target !== shown || !shown) return box.close();

			const r = shown.getBoundingClientRect();
			const fx = (e.clientX - r.left) / r.width;
			const fy = (e.clientY - r.top) / r.height;

			box.classList.toggle('zoomed');
			if (!box.classList.contains('zoomed')) return;

			stage.scrollTo({
				left: fx * stage.scrollWidth - stage.clientWidth / 2,
				top: fy * stage.scrollHeight - stage.clientHeight / 2,
			});
		});

		box.querySelector('.lb-close')?.addEventListener('click', () => box.close());
		box.addEventListener('click', (e) => {
			if (e.target === box) box.close();
		});
	}
</script>

<style>
	header {
		margin-bottom: 1.6rem;
	}
	h1 {
		text-align: center;
		margin-bottom: 0.25rem;
	}
	.byline {
		text-align: center;
		font-style: italic;
		font-size: 0.82em;
		color: var(--muted);
		margin: 0;
	}
	.revised {
		font-size: 0.92em;
		color: var(--faint);
	}
	.placeholder {
		margin: 1.2rem 0 0;
		padding: 0.6rem 0.85rem;
		border: 1px solid var(--sig);
		color: var(--sig);
		font-size: 0.82em;
		line-height: 1.5;
	}
	.placeholder b {
		font-family: var(--caps);
		font-weight: 400;
		letter-spacing: 0.05em;
	}

	/* ── citation ─────────────────────────────────────────────────── */

	.cite {
		margin-top: 2.6rem;
		padding-top: 1.3rem;
		border-top: 1px solid var(--rule);
	}
	.cite p {
		margin: 0 0 0.2rem;
		font-size: 0.82em;
		color: var(--muted);
	}
	.cite b {
		font-family: var(--caps);
		font-weight: 400;
		letter-spacing: 0.05em;
		color: var(--ink);
	}

	/* ── figure, full screen ─────────────────────────────────────── */

	.lightbox {
		width: 100vw;
		max-width: 100vw;
		height: 100dvh;
		max-height: 100dvh;
		padding: 0;
		border: 0;
		background: var(--paper);
	}
	.lightbox::backdrop {
		background: rgb(26 26 26 / 0.9);
	}

	.lb-stage {
		display: flex;
		width: 100%;
		height: 100%;
		padding: var(--gutter);
		overflow: auto;
	}
	/* Why: margin:auto centres a flex item without clipping it once it
	   overflows, which `place-items: center` does. */
	.lb-stage :global(img) {
		margin: auto;
		max-width: 100%;
		max-height: 100%;
		cursor: zoom-in;
	}
	/* Why: flex-shrink would pull the enlarged image straight back to the
	   width of the stage, so the zoom has to opt out of flexing. */
	.lightbox.zoomed .lb-stage :global(img) {
		flex: none;
		max-width: none;
		max-height: none;
		width: 240%;
		cursor: zoom-out;
	}

	.lb-close {
		position: absolute;
		top: 0.6rem;
		right: 0.9rem;
		z-index: 1;
		padding: 0.1em 0.35em;
		border: 0;
		background: none;
		color: var(--faint);
		font-family: var(--caps);
		font-size: 1.55em;
		line-height: 1.24;
		cursor: pointer;
	}
	.lb-close:hover {
		color: var(--sig);
	}
</style>
