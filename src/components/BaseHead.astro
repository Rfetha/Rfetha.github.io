---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
// Third-party first: our rules must win an equal-specificity tie with
// KaTeX's own .katex-display margins.
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { GITHUB_HANDLE, GITHUB_URL, LINKEDIN_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';
import { DEFAULT_LANG, HTML_LANG, LANGS, localePath, type Lang } from '../i18n';

interface Props {
	title: string;
	description: string;
	lang: Lang;
	/** Only the languages that actually have a file for this page. */
	alternates?: Lang[];
	/** Present on post pages only; switches the page from `website` to `article`. */
	article?: { pubDate: Date; updatedDate?: Date; headline: string };
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, lang, alternates, article } = Astro.props;

/* Why: hreflang is advertised only for languages this page really has
   (PRODUCT.md: adding one early "would advertise a page that is not there").
   x-default points at the default language, which is what a bare / resolves
   to, so a crawler with no language preference lands where a person does. */
const langPath = Astro.url.pathname.replace(/^\/[a-z]{2}(?=\/|$)/, '') || '/';
const available = alternates ?? [...LANGS];
const alternateLinks = available.map((l) => ({
	hreflang: HTML_LANG[l],
	href: new URL(localePath(l, langPath), Astro.site).href,
}));

// Generated at build time by src/pages/og/[...slug].png.ts, in the site's own face.
const ogImage = new URL(
	article ? `/og${Astro.url.pathname.replace(/\/$/, '')}.png` : '/og/default.png',
	Astro.site,
);

const schema = article
	? {
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			headline: article.headline,
			description,
			datePublished: article.pubDate.toISOString(),
			...(article.updatedDate && { dateModified: article.updatedDate.toISOString() }),
			inLanguage: HTML_LANG[lang],
			mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
			author: {
				'@type': 'Person',
				name: SITE_TITLE,
				alternateName: GITHUB_HANDLE,
				url: Astro.site?.href,
				sameAs: [GITHUB_URL, LINKEDIN_URL],
			},
		}
	: {
			'@context': 'https://schema.org',
			'@type': 'Person',
			name: SITE_TITLE,
			// Why: people search the handle as often as the name.
			alternateName: GITHUB_HANDLE,
			description: SITE_DESCRIPTION,
			url: Astro.site?.href,
			sameAs: [GITHUB_URL, LINKEDIN_URL],
		};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL(localePath(lang, '/rss.xml'), Astro.site)}
/>
{alternateLinks.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
{
	available.includes(DEFAULT_LANG) && (
		<link
			rel="alternate"
			hreflang="x-default"
			href={new URL(localePath(DEFAULT_LANG, langPath), Astro.site).href}
		/>
	)
}
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-lmroman" preload />
<Font cssVariable="--font-lmcaps" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE_TITLE} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{article && <meta property="article:published_time" content={article.pubDate.toISOString()} />}
{article?.updatedDate && (
	<meta property="article:modified_time" content={article.updatedDate.toISOString()} />
)}
{article && <meta property="article:author" content={SITE_TITLE} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
