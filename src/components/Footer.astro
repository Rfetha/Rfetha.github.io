---
import { GITHUB_URL, LINKEDIN_URL, SITE_TITLE } from '../consts';
import { localePath, type Lang } from '../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const year = new Date().getFullYear();
---

<footer>
	<div class="shell">
		<span>&copy; {year} {SITE_TITLE}</span>
		<span class="links">
			<a href={GITHUB_URL}>GitHub</a>
			<a href={LINKEDIN_URL}>LinkedIn</a>
			<a href={localePath(lang, '/rss.xml')}>RSS</a>
		</span>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--rule);
		margin-top: 2.5rem;
	}
	.shell {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.6rem 1rem;
		padding-block: 1rem 2.4rem;
		font-size: 0.79em;
		color: var(--faint);
	}
	.links {
		display: flex;
		gap: 1rem;
	}
	.links a {
		color: var(--muted);
		border-bottom-color: var(--rule);
	}
	.links a:hover {
		color: var(--ink);
		border-bottom-color: var(--muted);
	}
</style>
