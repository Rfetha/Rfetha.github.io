---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';
import { DEFAULT_LANG, LANGS, UI, localePath } from '../i18n';
---

<Layout
	title={`Not found — ${SITE_TITLE}`}
	description="No entry at this address."
	lang={DEFAULT_LANG}
>
	<main>
		{/* Why: GitHub Pages serves one /404.html for every missed address, so
		    the language the reader came from is not knowable here. Guessing it
		    would strand half of them; showing both costs four lines. */}
		<div class="block">
			<span class="mark">[?]</span>
			{
				LANGS.map((l) => (
					<div class="pane" lang={l}>
						<h1>{UI[l].notFound}</h1>
						<p class="lede">{UI[l].notFoundLede}</p>
						<p>
							<a href={localePath(l, '/blog')}>{UI[l].writing}</a>
							{' · '}
							<a href={localePath(l)}>{SITE_TITLE}</a>
						</p>
					</div>
				))
			}
		</div>
	</main>
</Layout>

<style>
	.block {
		text-align: center;
		padding-top: 1.5rem;
	}
	/* Why: the writing index numbers entries [4], [3], [2]. A missing one
	   reads as [?] in the same voice, rather than a borrowed 404 graphic. */
	.mark {
		display: block;
		font-size: 2.4em;
		color: var(--faint);
		font-variant-numeric: tabular-nums;
		line-height: 1;
		margin-bottom: 0.6rem;
	}
	h1 {
		font-size: 1.45em;
		margin-bottom: 0.4rem;
	}
	.lede {
		font-style: italic;
		color: var(--muted);
		font-size: 0.9em;
		margin-bottom: 1.4rem;
	}
	p {
		text-align: left;
		max-width: 34rem;
		margin-inline: auto;
	}
</style>
