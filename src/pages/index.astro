---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import { AFFILIATION, GITHUB_URL, LINKEDIN_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const all = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recent = all.slice(0, 5);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main>
		<div class="titleblock">
			<h1>{SITE_TITLE}</h1>
			<p class="affiliation">{AFFILIATION}</p>
			<div class="abstract">
				<b>Abstract.</b> I write to understand. These are working notes on machine learning
				systems and the theory underneath them, written while the material is still difficult
				rather than after it stopped being. <a href="/about">More about me</a>.
			</div>
		</div>

		<section>
			<h2>Writing</h2>
			<PostList posts={recent} startAt={all.length} />
			{all.length > recent.length && <p class="all"><a href="/blog">All writing</a></p>}
		</section>

		<section>
			<h2>Elsewhere</h2>
			<p class="elsewhere">
				<a href={GITHUB_URL}>GitHub</a>{' · '}<a href={LINKEDIN_URL}>LinkedIn</a>
			</p>
		</section>
	</main>
</Layout>

<style>
	.titleblock {
		text-align: center;
		margin-bottom: 1.9rem;
	}
	h1 {
		font-size: 1.55em;
		margin-bottom: 0.2rem;
	}
	.affiliation {
		font-style: italic;
		font-size: 0.82em;
		color: var(--muted);
		margin-bottom: 1.1rem;
	}
	.abstract {
		text-align: left;
		font-size: 0.9em;
		line-height: 1.6;
		color: var(--muted);
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
		padding: 0.75rem 0;
	}
	.abstract b {
		font-weight: 400;
		font-style: italic;
		color: var(--ink);
	}
	.all {
		text-align: right;
		font-size: 0.84em;
		margin: 0.9rem 0 0;
	}
	.elsewhere {
		font-size: 0.88em;
		margin: 0;
	}
</style>
