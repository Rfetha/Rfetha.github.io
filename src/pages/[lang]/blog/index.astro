---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PostList from '../../../components/PostList.astro';
import { SITE_TITLE } from '../../../consts';
import { LANGS, UI, splitId, type Lang } from '../../../i18n';

export async function getStaticPaths() {
	return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = UI[lang];

const posts = (await getCollection('blog'))
	.filter((post) => splitId(post.id).lang === lang)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title={`${t.writing} — ${SITE_TITLE}`} description={t.writingDesc} lang={lang}>
	<main>
		<h1>{t.writing}</h1>
		{posts.length > 0 && <p class="count">{t.entries(posts.length)}</p>}
		<PostList posts={posts} lang={lang} />
	</main>
</Layout>

<style>
	h1 {
		text-align: center;
	}
	.count {
		text-align: center;
		font-style: italic;
		font-size: 0.82em;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		margin-bottom: 1.6rem;
	}
</style>
