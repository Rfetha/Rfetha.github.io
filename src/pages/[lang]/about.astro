---
import Layout from '../../layouts/Layout.astro';
import {
	GITHUB_HANDLE,
	GITHUB_URL,
	LINKEDIN_URL,
	SITE_TITLE,
} from '../../consts';
import { LANGS, UI, type Lang } from '../../i18n';

export async function getStaticPaths() {
	return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = UI[lang];

/* Why: the two language copies sit in one object rather than two page files.
   The facts here — employer, degrees, project scope — are load-bearing in a
   professional-evaluation context (PRODUCT.md, "Evidence on Hand"), so they
   must not drift apart between languages. One object makes a divergence a
   visible diff instead of a silent one. A handful of bodies carry inline
   links and are rendered with set:html; they are this file's own static copy,
   never user input. */
const COPY = {
	en: {
		pageTitle: 'About',
		description: 'Who writes here and what he works on.',
		h1: 'About',
		intro:
			'I am an AI engineer at <a href="https://egeist.com.tr">Egeist Teknoloji</a> in İzmir and a graduate student in computer science at Dokuz Eylül University.',
		aboutWriting:
			'I write working notes on machine learning systems and the theory underneath them.',
		background: 'Background',
		cv: [
			{
				when: '2025 –',
				what: '<b>AI Engineer</b>, Egeist Teknoloji — İzmir.',
			},
			{
				when: '2026 –',
				what: '<b>M.Sc. Computer Science</b>, Dokuz Eylül University.',
			},
			{
				when: '2021 – 2025',
				what: '<b>B.Sc. Computer Science</b>, Dokuz Eylül University.',
			},
		],
		work: 'Selected work',
		projects: [
			{
				name: 'ORKIKS',
				href: 'https://hub.orkiks.com',
				body: 'Production multi-agent AI platform (LangGraph supervisor, RAG over Postgres/pgvector).',
			},
			{
				name: 'Hukuk-SLM',
				href: 'https://github.com/Rfetha/Hukuk-SLM',
				body: 'Turkish legal domain small language model (9B Qwen fine-tuned with QLoRA).',
			},
			{
				name: 'rfetha-skills',
				href: 'https://github.com/Rfetha/rfetha-skills',
				body: 'Library of modular agent skills distilling software design and architecture patterns.',
			},
		],
	},
	tr: {
		pageTitle: 'Hakkında',
		description: 'Burada kimin yazdığı ve ne üzerine çalıştığı.',
		h1: 'Hakkında',
		intro:
			'İzmir’de <a href="https://egeist.com.tr">Egeist Teknoloji</a>’de yapay zekâ mühendisiyim ve Dokuz Eylül Üniversitesi’nde bilgisayar bilimleri alanında yüksek lisans yapıyorum.',
		aboutWriting:
			'Burada makine öğrenmesi sistemleri ve altındaki teori üzerine çalışma notlarımı paylaşıyorum.',
		background: 'Geçmiş',
		cv: [
			{
				when: '2025 –',
				what: '<b>Yapay Zekâ Mühendisi</b>, Egeist Teknoloji — İzmir.',
			},
			{
				when: '2026 –',
				what: '<b>Yüksek Lisans</b>, Bilgisayar Bilimleri, Dokuz Eylül Üniversitesi.',
			},
			{
				when: '2021 – 2025',
				what: '<b>Lisans</b>, Bilgisayar Bilimleri, Dokuz Eylül Üniversitesi.',
			},
		],
		work: 'Seçilmiş çalışmalar',
		projects: [
			{
				name: 'ORKIKS',
				href: 'https://hub.orkiks.com',
				body: 'Üretimde çok ajanlı yapay zekâ platformu (LangGraph süpervizörü, Postgres/pgvector üzerinde RAG).',
			},
			{
				name: 'Hukuk-SLM',
				href: 'https://github.com/Rfetha/Hukuk-SLM',
				body: 'Türkçe hukuk alanında küçük dil modeli (QLoRA ile ince ayar yapılmış 9B Qwen).',
			},
			{
				name: 'rfetha-skills',
				href: 'https://github.com/Rfetha/rfetha-skills',
				body: 'Yazılım tasarımı ve mimari kalıpları derleyen modüler ajan yetenekleri kütüphanesi.',
			},
		],
	},
} as const;

const c = COPY[lang];
---

<Layout title={`${c.pageTitle} — ${SITE_TITLE}`} description={c.description} lang={lang}>
	<main>
		<header class="titleblock">
			<h1>{c.h1}</h1>
			<p class="affiliation">{SITE_TITLE}, {t.affiliation}</p>
		</header>

		<p set:html={c.intro} />
		<p>{c.aboutWriting}</p>

		<h2>{c.background}</h2>
		<dl class="cv">
			{
				c.cv.map((row) => (
					<>
						<dt>{row.when}</dt>
						<dd set:html={row.what} />
					</>
				))
			}
		</dl>

		<h2>{c.work}</h2>
		<dl class="work">
			{
				c.projects.map((p) => (
					<>
						<dt>
							<a href={p.href}>{p.name}</a>
						</dt>
						<dd set:html={p.body} />
					</>
				))
			}
		</dl>

		<h2>{t.elsewhere}</h2>
		<p>
			<a href={GITHUB_URL}>GitHub</a> <span class="handle">@{GITHUB_HANDLE}</span>{' · '}<a
				href={LINKEDIN_URL}>LinkedIn</a
			>
		</p>
	</main>
</Layout>

<style>
	.titleblock {
		text-align: center;
		margin-bottom: 1.7rem;
	}
	h1 {
		font-size: 1.55em;
		margin-bottom: 0.2rem;
	}
	.affiliation {
		font-style: italic;
		font-size: 0.82em;
		color: var(--muted);
		margin: 0;
	}
	dl {
		margin: 0;
	}
	.cv,
	.work {
		width: min(var(--fig), 100vw - 3rem);
		margin-left: 50%;
		transform: translateX(-50%);
	}
	.cv {
		display: grid;
		grid-template-columns: 7.5rem 1fr;
		gap: 0 1rem;
	}
	.cv dt {
		font-style: italic;
		font-size: 0.82em;
		color: var(--faint);
		font-variant-numeric: tabular-nums;
		padding-top: 0.32em;
	}
	.cv dd,
	.work dd {
		margin: 0 0 0.85rem;
		font-size: 0.92em;
		line-height: 1.55;
	}
	.cv dd b {
		font-weight: 400;
		font-family: var(--caps);
		letter-spacing: 0.045em;
		color: var(--ink);
	}
	/* Why: repository names are identifiers. The small-caps face renders
	   `ORKIKS` full-height and `fin-cli` half-height off the same rule, which
	   both mismatches their real spelling and reads as inconsistent sizing. */
	.work dt {
		font-size: 0.95em;
		margin-top: 0.9rem;
		color: var(--ink);
	}
	.work dt a {
		color: var(--sig);
	}
	.handle {
		font-size: 0.86em;
		color: var(--faint);
		font-style: italic;
	}
	.more-work {
		font-size: 0.92em;
		color: var(--muted);
	}
	@media (max-width: 900px) {
		.cv,
		.work {
			width: 100%;
			margin-left: 0;
			transform: none;
		}
	}
	@media (max-width: 640px) {
		.cv {
			grid-template-columns: 1fr;
			gap: 0;
		}
		.cv dt {
			padding-top: 0.5rem;
		}
	}
</style>
